diff --git a/lib/dolphin/os/OSMemory.cpp b/lib/dolphin/os/OSMemory.cpp
index 2a963a5..582f13b 100644
--- a/lib/dolphin/os/OSMemory.cpp
+++ b/lib/dolphin/os/OSMemory.cpp
@@ -8,6 +8,10 @@
 
 #include <cassert>
 
+#if defined(__linux__) && defined(__x86_64__)
+#include <sys/mman.h>
+#endif
+
 #include "internal.hpp"
 #include <dolphin/os.h>
 #include "dolphin/types.h"
@@ -138,6 +142,27 @@ static void* AllocMEM1(u32 size) {
 }
 #else
 static void* AllocMEM1(u32 size) {
+  // MEM1 must live in the low 4GB.
+  //
+  // DAT archives store their internal pointers as 32-bit offsets and the HSD
+  // loader relocates them in place (`*ptr += (u32)archive->data`) into 4-byte
+  // slots. If the archive sits above 4GB there is simply nowhere to put a host
+  // pointer -- the slot is too small -- and every relocated pointer is
+  // truncated garbage.
+  //
+  // Below 2GB specifically, not merely below 4GB: the game also round-trips
+  // pointers through *signed* 32-bit slots (`cmd[1] = (s32) state`,
+  // hsd_3A94.c:2326). An address of 0x8xxxxxxx would come back sign-extended
+  // and unusable, so MAP_32BIT -- which allocates below 2GB -- is what keeps
+  // those lossless. See docs/cmake_pc_port.md.
+#if defined(__linux__) && defined(__x86_64__)
+  void* p = mmap(nullptr, size, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_32BIT, -1, 0);
+  if (p != MAP_FAILED) {
+    return p;
+  }
+  // Fall through: better a working high allocation than none at all.
+#endif
   return calloc(1, size);
 }
 #endif
